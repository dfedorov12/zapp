    <bpmn:sequenceFlow id="f6" name="ja" sourceRef="GwS1" targetRef="GwZwei" />
    <bpmn:sequenceFlow id="f7" name="ja" sourceRef="GwZwei" targetRef="T4" />
    <bpmn:sequenceFlow id="f8" sourceRef="T4" targetRef="GwS2" />
    <bpmn:sequenceFlow id="f9" name="ja" sourceRef="GwS2" targetRef="TGen" />
    <bpmn:sequenceFlow id="f10" sourceRef="TGen" targetRef="EndGen" />
    <bpmn:sequenceFlow id="f11" name="nein" sourceRef="GwZwei" targetRef="TGen" />
    <bpmn:sequenceFlow id="f12" name="nein" sourceRef="GwS1" targetRef="TRej" />
    <bpmn:sequenceFlow id="f13" name="nein" sourceRef="GwS2" targetRef="TRej" />
    <bpmn:sequenceFlow id="f14" sourceRef="TRej" targetRef="EndAbg" />
    <bpmn:sequenceFlow id="f15" name="nein" sourceRef="GwGen" targetRef="GwDok" />
    <bpmn:sequenceFlow id="f16" name="ja" sourceRef="GwDok" targetRef="TDoku" />
    <bpmn:sequenceFlow id="f17" sourceRef="TDoku" targetRef="EndDok" />
    <bpmn:sequenceFlow id="f18" name="nein" sourceRef="GwDok" targetRef="TKeine" />
    <bpmn:sequenceFlow id="f19" sourceRef="TKeine" targetRef="EndKeine" />
  </bpmn:process>
